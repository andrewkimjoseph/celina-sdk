{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "build",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "declaration": true,
    "sourceMap": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@cnvlabskoxyz/celina-sdk": ["./src/index.ts"],
      "@cnvlabskoxyz/celina-sdk/testing": ["./tests/testing-entry.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "build", "src/clients/generated/*.bundle.js"]
}
