{
  "name": "@andrewkimjoseph/celina-sdk",
  "version": "0.7.1",
  "description": "Celina SDK — Celo mainnet reads and unsigned transaction preparation for frontend apps.",
  "type": "module",
  "sideEffects": false,
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js",
      "default": "./build/index.js"
    },
    "./testing": {
      "types": "./tests/testing-entry.ts",
      "import": "./tests/testing-entry.ts",
      "default": "./tests/testing-entry.ts"
    },
    "./tools": {
      "types": "./build/tools/index.d.ts",
      "import": "./build/tools/index.js",
      "default": "./build/tools/index.js"
    }
  },
  "files": [
    "build/",
    "tests/catalog/",
    "tests/fixtures/",
    "tests/helpers/",
    "tests/testing-entry.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "node scripts/generate-mcp-analytics-map.mjs",
    "build": "npm run prebuild && rm -rf build && tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "docs:api": "typedoc",
    "docs:summary": "node scripts/update-api-summary.mjs",
    "docs:build": "npm run docs:api && npm run docs:summary",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "celina",
    "celina-sdk",
    "celo",
    "blockchain",
    "web3",
    "wagmi",
    "viem",
    "mento",
    "aave",
    "uniswap",
    "sdk"
  ],
  "author": "Andrew Kim Joseph",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewkimjoseph/celina-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/andrewkimjoseph/celina-sdk/issues"
  },
  "homepage": "https://andrewkimjoseph.gitbook.io/celina-sdk",
  "dependencies": {
    "zod": "^3.24.3",
    "@amplitude/analytics-node": "^1.5.21",
    "@noble/ed25519": "^3.1.0",
    "@bancor/carbon-sdk": "0.0.130-DEV",
    "@mento-protocol/mento-sdk": "^3.2.8",
    "@uniswap/sdk-core": "^7.16.1",
    "@uniswap/universal-router-sdk": "^5.5.1",
    "@uniswap/v4-sdk": "^2.2.1",
    "ethers": "^6.15.0",
    "viem": "^2.39.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "^5.8.2",
    "vitest": "^3.2.4"
  }
}
